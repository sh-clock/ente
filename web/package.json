{
    "name": "photos-web",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "packages/wasm/*"
    ],
    "scripts": {
        "build": "npm run build:photos",
        "build:photos": "npm run build:prelogin-wasm && npm run build:photos-wasm && npm exec --workspace photos -- next build --webpack",
        "build:photos-wasm": "npm run build --workspace ente-photos-wasm",
        "build:prelogin-wasm": "npm run build --workspace ente-prelogin-wasm",
        "dev": "npm run dev:photos",
        "dev:photos": "npm run build:prelogin-wasm && npm run build:photos-wasm && npm exec --workspace photos -- next dev --webpack -p 3000",
        "lint": "node scripts/lint.mjs",
        "lint:fix": "node scripts/lint.mjs --fix",
        "test": "npm run test --workspace ente-wasm-tests && npm run test --workspace ente-prelogin-wasm && npm run test --workspace ente-contacts && npm run test --workspace photos"
    },
    "overrides": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "base-x": "5.0.1",
        "concurrently": {
            "shell-quote": "1.11.0"
        },
        "micromark-extension-math": {
            "katex": "0.18.2"
        },
        "rehype-katex": {
            "katex": "0.18.2"
        }
    },
    "devDependencies": {
        "concurrently": "10.0.5",
        "eslint": "10.12.0",
        "knip": "6.41.0",
        "prettier": "3.9.9",
        "typescript": "6.0.3"
    },
    "packageManager": "npm@11.12.1"
}
